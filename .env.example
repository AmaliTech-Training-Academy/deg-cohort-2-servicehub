# Copy this file to .env and fill in real values — never commit .env
# cp .env.example .env

# ─── Database ────────────────────────────────────────────────
DB_NAME=projectdb
DB_USER=postgres
DB_PASSWORD=

# ─── Spring Boot ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
# datasource is built automatically from DB_* vars in docker-compose.yml

# ─── JWT — generate a strong secret ──────────────────────────
# Example: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# ─── Local dev port overrides ────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000
